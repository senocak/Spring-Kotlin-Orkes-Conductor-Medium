[
  {
    "name": "order_fulfillment_workflow",
    "description": "Real-world order fulfillment flow with payment decision, delivery scheduling, compensation, and customer notification",
    "version": 1,
    "schemaVersion": 2,
    "inputParameters": [
      "orderId",
      "customerId",
      "items",
      "totalAmount",
      "deliveryAddress",
      "paymentMethod",
      "priority",
      "notificationChannel"
    ],
    "tasks": [
      {
        "name": "validate_order",
        "taskReferenceName": "validate_order_ref",
        "inputParameters": {
          "orderId": "${workflow.input.orderId}",
          "customerId": "${workflow.input.customerId}",
          "items": "${workflow.input.items}",
          "totalAmount": "${workflow.input.totalAmount}",
          "deliveryAddress": "${workflow.input.deliveryAddress}"
        },
        "type": "SIMPLE"
      },
      {
        "name": "reserve_inventory",
        "taskReferenceName": "reserve_inventory_ref",
        "inputParameters": {
          "orderId": "${validate_order_ref.output.orderId}",
          "items": "${validate_order_ref.output.items}"
        },
        "type": "SIMPLE"
      },
      {
        "name": "process_payment",
        "taskReferenceName": "process_payment_ref",
        "inputParameters": {
          "orderId": "${validate_order_ref.output.orderId}",
          "customerId": "${validate_order_ref.output.customerId}",
          "totalAmount": "${validate_order_ref.output.totalAmount}",
          "paymentMethod": "${workflow.input.paymentMethod}"
        },
        "type": "SIMPLE"
      },
      {
        "name": "payment_decision",
        "taskReferenceName": "payment_decision_ref",
        "inputParameters": {
          "payment_status": "${process_payment_ref.output.paymentStatus}"
        },
        "type": "DECISION",
        "caseValueParam": "payment_status",
        "decisionCases": {
          "APPROVED": [
            {
              "name": "schedule_delivery",
              "taskReferenceName": "schedule_delivery_ref",
              "inputParameters": {
                "orderId": "${validate_order_ref.output.orderId}",
                "deliveryAddress": "${validate_order_ref.output.deliveryAddress}",
                "priority": "${workflow.input.priority}"
              },
              "type": "SIMPLE"
            },
            {
              "name": "send_order_notification",
              "taskReferenceName": "send_order_confirmation_ref",
              "inputParameters": {
                "orderId": "${validate_order_ref.output.orderId}",
                "customerId": "${validate_order_ref.output.customerId}",
                "channel": "${workflow.input.notificationChannel}",
                "status": "CONFIRMED",
                "message": "Order ${validate_order_ref.output.orderId} is confirmed. Delivery ETA is ${schedule_delivery_ref.output.etaMinutes} minutes."
              },
              "type": "SIMPLE"
            }
          ],
          "DECLINED": [
            {
              "name": "release_inventory",
              "taskReferenceName": "release_inventory_ref",
              "inputParameters": {
                "orderId": "${validate_order_ref.output.orderId}",
                "reservationId": "${reserve_inventory_ref.output.reservationId}",
                "reason": "${process_payment_ref.output.reason}"
              },
              "type": "SIMPLE"
            },
            {
              "name": "send_order_notification",
              "taskReferenceName": "send_order_declined_ref",
              "inputParameters": {
                "orderId": "${validate_order_ref.output.orderId}",
                "customerId": "${validate_order_ref.output.customerId}",
                "channel": "${workflow.input.notificationChannel}",
                "status": "PAYMENT_DECLINED",
                "message": "Order ${validate_order_ref.output.orderId} could not be completed because payment was declined."
              },
              "type": "SIMPLE"
            }
          ]
        },
        "defaultCase": [
          {
            "name": "release_inventory",
            "taskReferenceName": "release_inventory_default_ref",
            "inputParameters": {
              "orderId": "${validate_order_ref.output.orderId}",
              "reservationId": "${reserve_inventory_ref.output.reservationId}",
              "reason": "Unexpected payment status: ${process_payment_ref.output.paymentStatus}"
            },
            "type": "SIMPLE"
          },
          {
            "name": "send_order_notification",
            "taskReferenceName": "send_order_review_ref",
            "inputParameters": {
              "orderId": "${validate_order_ref.output.orderId}",
              "customerId": "${validate_order_ref.output.customerId}",
              "channel": "${workflow.input.notificationChannel}",
              "status": "PENDING_REVIEW",
              "message": "Order ${validate_order_ref.output.orderId} is pending manual review."
            },
            "type": "SIMPLE"
          }
        ]
      }
    ]
  }
]
